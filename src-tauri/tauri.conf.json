{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "somachron",
    "version": "0.1.0",
    "identifier": "com.shank.somachron-app",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "Somachron",
                "width": 1200,
                "height": 800,
                "decorations": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "transparent": false,
                "resizable": true,
                "fullscreen": false,
                "center": true,
                "minWidth": 800,
                "minHeight": 800,
                "trafficLightPosition": {
                    "x": 11,
                    "y": 20
                }
            }
        ],
        "security": {
            "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' https://clerk.*.com https://*.clerk.accounts.dev; img-src 'self' asset: http://asset.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
